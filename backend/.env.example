# Wyzie Worker Configuration (Option 1: Keeps your Wyzie API key 100% private)
# Deploy backend/workers/wyzie-worker.js to Cloudflare Workers with secrets:
# - NITRO_API_TOKEN=<your_wyzie_api_key>
# - NITRO_WORKER_KEY=<your_custom_secret_bearer_key>
